{
  "name": "@avanio/jwt-util",
  "version": "0.1.1",
  "description": "NodeJS JWT utils",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --sourcemap --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build",
    "test": "vitest test --run --no-isolate --coverage",
    "coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
    "lint": "biome check",
    "validate": "tsc --noEmit"
  },
  "files": ["dist"],
  "repository": "github:luolapeikko/jwt-util",
  "keywords": ["jwt", "nodejs"],
  "author": "mharj",
  "license": "LGPL-2.0-only",
  "bugs": {
    "url": "https://github.com/luolapeikko/jwt-util/issues"
  },
  "homepage": "https://github.com/luolapeikko/jwt-util#readme",
  "devDependencies": {
    "@avanio/expire-cache": "^0.6.10",
    "@azure/msal-node": "^5.4.3",
    "@biomejs/biome": "2.5.6",
    "@luolapeikko/cache-types": "^0.0.10",
    "@luolapeikko/logger-type": "^0.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/node-forge": "^1.3.14",
    "@vitest/coverage-v8": "^4.1.10",
    "c8": "^12.0.0",
    "dotenv": "^17.4.2",
    "google-auth-library": "^11.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-forge": "^1.4.0",
    "source-map-support": "^0.5.21",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@avanio/expire-cache": ">= 0.6.3",
    "@luolapeikko/cache-types": ">= 0.0.1",
    "@luolapeikko/logger-type": ">= 0.0.1",
    "@types/jsonwebtoken": "^9.0",
    "jsonwebtoken": "^9.0"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
