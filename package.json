{
  "name": "@avanio/jwt-util",
  "version": "0.1.2",
  "description": "NodeJS JWT utils",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --sourcemap --format cjs,esm --dts --clean -c tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest test --run --no-isolate --coverage",
    "coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
    "lint": "biome check",
    "validate": "tsc --noEmit"
  },
  "files": ["dist"],
  "repository": "github:luolapeikko/jwt-util",
  "keywords": ["jwt", "nodejs"],
  "author": "mharj",
  "license": "LGPL-2.0-only",
  "bugs": {
    "url": "https://github.com/luolapeikko/jwt-util/issues"
  },
  "homepage": "https://github.com/luolapeikko/jwt-util#readme",
  "devDependencies": {
    "@avanio/expire-cache": "^0.7.0",
    "@azure/msal-node": "^6.0.1",
    "@biomejs/biome": "^2.5.14",
    "@luolapeikko/cache-types": "^0.0.10",
    "@luolapeikko/logger-type": "^0.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.5",
    "@types/node-forge": "^1.3.14",
    "@vitest/coverage-v8": "^5.0.1",
    "c8": "^12.0.0",
    "dotenv": "^18.0.0",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-forge": "^1.4.0",
    "source-map-support": "^0.5.21",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@avanio/expire-cache": ">= 0.6.3",
    "@luolapeikko/cache-types": ">= 0.0.1",
    "@luolapeikko/logger-type": ">= 0.0.1",
    "@types/jsonwebtoken": "^9.0",
    "jsonwebtoken": "^9.0"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
